# انسخ هذا الملف إلى .env واملأ القيم من لوحة مشروع Supabase
# (Project Settings → API)
#
# ملاحظة: في Expo، فقط المتغيّرات التي تبدأ بـ EXPO_PUBLIC_ تصل لكود التطبيق.
# بعد تعديل هذا الملف، أعد تشغيل الخادم مع مسح الكاش: npx expo start -c

# رابط مشروع Supabase، مثال: https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# المفتاح العام القابل للنشر (Publishable / anon key) — آمن للعميل، يحترم RLS.
# لا تضع هنا أبداً مفتاح الخدمة (service_role / secret key).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
