# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة مشروع Supabase
# (Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح الخدمة (server-only) — لا يبدأ بـ NEXT_PUBLIC، لا يُقرأ في المتصفح.
# يُستخدم في استرجاع كلمة المرور وإرسال الإشعارات.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- الإشعارات الفورية (Web Push) ---
# المفتاح العام: آمن كشفه، يُدمج بالواجهة.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# المفتاح الخاص: سرّ، server-only فقط.
VAPID_PRIVATE_KEY=your-vapid-private-key
# جهة الاتصال (بريدك) بصيغة mailto:
VAPID_SUBJECT=mailto:you@example.com
# سرّ مشترك يتحقّق منه مسار /api/push/send من هيدر x-webhook-secret
# (نفس القيمة تُضبط في هيدر Database Webhook داخل Supabase).
PUSH_WEBHOOK_SECRET=a-long-random-secret

# ملاحظة: المتغيّرات التي لا تبدأ بـ NEXT_PUBLIC لا تصل للمتصفح إطلاقاً.
